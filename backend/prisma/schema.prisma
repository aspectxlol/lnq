generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//
// Enums
//

enum Role {
  CUSTOMER
  STAFF
  ADMIN
  OWNER
}

enum ItemType {
  PRODUCT
  CUSTOM
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CouponType {
  PERCENTAGE
  FIXED
}

//
// Authentication
//

//TODO: IMPLEMENT ACCOUNT LINKING FOR MULTIPLE OAUTH PROVIDERS PER USER(GOOGLE, FACEBOOK, ETC.)

model User {
  id              Int       @id @default(autoincrement())

  email           String    @unique
  passwordHash    String?

  firstName       String
  lastName        String?

  phone           String?

  role            Role      @default(CUSTOMER)

  emailVerified   Boolean   @default(false)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sessions        Session[]
  addresses       Address[]
  orders          Order[]
}

model Session {
  id                  Int      @id @default(autoincrement())

  userId              Int

  refreshTokenHash    String

  expiresAt           DateTime

  createdAt           DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

//
// Catalog
//

model Category {
  id          Int      @id @default(autoincrement())

  name        String

  slug        String   @unique

  description String?

  active      Boolean  @default(true)

  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())

  products    Product[]
}

model Product {
  id          Int      @id @default(autoincrement())

  categoryId  Int?

  sku         String   @unique

  slug        String   @unique

  name        String

  description String?

  price       Int

  stock       Int      @default(0)

  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  images ProductImage[]

  orderItems OrderItem[]
}

model ProductImage {
  id          Int      @id @default(autoincrement())

  productId   Int

  objectKey   String

  altText     String?

  sortOrder   Int      @default(0)

  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

//
// Coupons
//

model Coupon {
  id              Int      @id @default(autoincrement())

  code            String   @unique

  type            CouponType

  value           Int

  minimumPurchase Int?

  usageLimit      Int?

  usedCount       Int      @default(0)

  active          Boolean  @default(true)

  startsAt        DateTime?

  expiresAt       DateTime?

  createdAt       DateTime @default(now())

  orders Order[]
}

//
// Orders
//

model Order {
  id            Int      @id @default(autoincrement())

  userId        Int?

  couponId      Int?

  orderNumber   String   @unique

  customerName  String

  status        OrderStatus @default(PENDING)

  subtotal      Int

  discount      Int      @default(0)

  tax           Int      @default(0)

  total         Int

  pickupDate    DateTime?

  notes         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  coupon Coupon? @relation(fields: [couponId], references: [id])

  items OrderItem[]
}

model OrderItem {
  id              Int      @id @default(autoincrement())

  orderId         Int

  itemType        ItemType @default(PRODUCT)

  productId       Int?

  quantity        Int?

  notes           String?

  priceAtSale     Int?

  customName      String?

  customPrice     Int?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  product Product? @relation(fields: [productId], references: [id])
}

//
// Customer Addresses
//

model Address {
  id              Int      @id @default(autoincrement())

  userId          Int

  label           String?

  recipientName   String

  phone           String

  street          String

  city            String

  province        String

  postalCode      String

  isDefault       Boolean  @default(false)

  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}